#!/usr/bin/env bash
# Refresh Google Scholar counts locally using the Ruby environment used by run.sh.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUBY_BIN="${RUBY_BIN:-/usr/local/Homebrew/Library/Homebrew/vendor/portable-ruby/3.1.4/bin}"

if [[ ! -x "${RUBY_BIN}/ruby" ]]; then
  echo "Ruby 3.1 not found at ${RUBY_BIN}/ruby" >&2
  echo "Install Ruby 3.1, or set RUBY_BIN to its bin directory." >&2
  exit 1
fi

export PATH="${RUBY_BIN}:${PATH}"
export BUNDLE_PATH="${ROOT}/vendor/bundle"
export RUBYOPT="${RUBYOPT:--EUTF-8}"

cd "${ROOT}"
if ! bundle check >/dev/null 2>&1; then
  bundle install
fi

exec bundle exec ruby bin/update-scholar-citations "$@"
