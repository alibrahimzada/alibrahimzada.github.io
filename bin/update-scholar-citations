#!/usr/bin/env ruby
# Run with bundle exec ruby bin/update-scholar-citations [saved-profile.html].
require 'json'
require 'yaml'
require 'date'
require 'net/http'
require 'uri'
require 'nokogiri'
require 'bibtex'

ROOT = File.expand_path('..', __dir__)
PROFILE = YAML.safe_load(File.read(File.join(ROOT, '_data/profile.yml'))).fetch('gscholar')
OUTPUT = File.join(ROOT, '_data/google_scholar_citations.json')

def normalize(title)
  title.unicode_normalize(:nfkd).downcase.gsub(/[^\p{L}\p{N}]/, '')
end

def fetch_profile(url)
  5.times do
    uri = URI(url)
    raise 'Unexpected Scholar URL' unless uri.scheme == 'https' && uri.host == 'scholar.google.com'
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true, open_timeout: 15, read_timeout: 30) { |http| http.get(uri.request_uri) }
    return response.body if response.is_a?(Net::HTTPSuccess)
    if response.is_a?(Net::HTTPRedirection)
      url = URI.join(url, response.fetch('location')).to_s
    else
      raise "Scholar returned HTTP #{response.code}; previous counts retained"
    end
  end
  raise 'Too many redirects; previous counts retained'
end

begin
  profile_url = "https://scholar.google.com/citations?user=#{URI.encode_www_form_component(PROFILE)}&hl=en&cstart=0&pagesize=100"
  html = ARGV[0] ? File.binread(ARGV[0]) : fetch_profile(profile_url)
  doc = Nokogiri::HTML(html)
  rows = doc.css('tr.gsc_a_tr')
  raise 'No publications found (possibly blocked); previous counts retained' if rows.empty?
  more = doc.at_css('#gsc_bpf_more')
  raise 'Profile exceeds one page; import a complete saved profile instead' if !ARGV[0] && more && !more.key?('disabled')
  papers = rows.filter_map do |row|
    title = row.at_css('a.gsc_a_at')
    citation = row.at_css('a.gsc_a_ac')
    next unless title && citation
    raw = citation.text.strip.delete(',')
    next unless raw.empty? || raw.match?(/\A\d+\z/)
    # Scholar uses an empty citation cell for an uncited publication.
    url = URI.join('https://scholar.google.com', title['href']).to_s
    { 'title' => title.text.strip, 'count' => raw.empty? ? 0 : raw.to_i, 'url' => url }
  end
  bibliography = BibTeX.parse(File.read(File.join(ROOT, '_bibliography/papers.bib'), encoding: 'UTF-8').sub(/\A---\s*\n---\s*\n/, ''))
  previous = File.exist?(OUTPUT) ? JSON.parse(File.read(OUTPUT)) : {}
  updates = {}
  bibliography.each do |entry|
    next unless entry.respond_to?(:key) && entry[:title]
    matches = papers.select { |paper| normalize(paper['title']) == normalize(entry[:title].to_s) }
    if entry[:google_scholar_id]
      matches = papers.select { |paper| URI.decode_www_form(URI(paper['url']).query).to_h['citation_for_view'] == "#{PROFILE}:#{entry[:google_scholar_id]}" }
    end
    if matches.length == 1
      updates[entry.key] = matches.first.merge('checked' => Date.today.iso8601)
    else
      warn "No unique Scholar match: #{entry.key} (#{entry[:title]})"
    end
  end
  raise 'No matching publications; previous counts retained' if updates.empty?
  result = previous.merge(updates)
  File.write(OUTPUT + '.tmp', JSON.pretty_generate(result) + "\n")
  File.rename(OUTPUT + '.tmp', OUTPUT)
  puts "Updated #{updates.length} Google Scholar citation counts."
rescue StandardError => e
  warn e.message
  exit 1
end
